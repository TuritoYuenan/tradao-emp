{
	"compilerOptions": {
		"jsx": "precompile",
		"jsxImportSource": "preact",
		"jsxPrecompileSkipElements": [
			"a",
			"img",
			"source",
			"body",
			"html",
			"head",
			"title",
			"meta",
			"script",
			"link",
			"style",
			"base",
			"noscript",
			"template"
		],
		"lib": [
			"dom",
			"dom.asynciterable",
			"dom.iterable",
			"deno.ns"
		],
		"types": [
			"vite/client"
		]
	},
	"deploy": {
		"app": "tradao",
		"org": "turitoyuenan"
	},
	"exclude": [
		"**/_fresh/*"
	],
	"fmt": {
		"indentWidth": 4,
		"lineWidth": 120,
		"quoteProps": "consistent",
		"semiColons": true,
		"singleQuote": true,
		"useTabs": true
	},
	"imports": {
		"@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
		"@preact/signals": "npm:@preact/signals@^2.5.1",
		"@std/dotenv": "jsr:@std/dotenv@^0.225.5",
		"@std/expect": "jsr:@std/expect@^1.0.17",
		"@std/testing": "jsr:@std/testing@^1.0.16",
		"@supabase/supabase-js": "npm:@supabase/supabase-js@^2.86.0",
		"@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.17",
		"$components/": "./components/",
		"$islands/": "./islands/",
		"$lib/": "./lib/",
		"fresh": "jsr:@fresh/core@^2.2.0",
		"jsqr": "npm:jsqr@^1.4.0",
		"preact": "npm:preact@^10.27.2",
		"vite": "npm:vite@^7.2.6",
		"yup": "npm:yup@^1.7.1"
	},
	"lint": {
		"rules": {
			"tags": [
				"fresh",
				"recommended"
			]
		}
	},
	"nodeModulesDir": "auto",
	"tasks": {
		"build": "vite build",
		"check": "deno fmt --check . && deno lint . && deno check",
		"dev": "vite",
		"start": "deno serve -A _fresh/server.js",
		"test": "deno test --coverage -A",
		"update": "deno run -A -r jsr:@fresh/update ."
	}
}
