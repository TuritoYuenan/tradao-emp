{
	"compilerOptions": {
		"jsx": "precompile",
		"jsxImportSource": "preact",
		"jsxPrecompileSkipElements": [
			"a",
			"img",
			"source",
			"body",
			"html",
			"head",
			"title",
			"meta",
			"script",
			"link",
			"style",
			"base",
			"noscript",
			"template"
		],
		"lib": [
			"dom",
			"dom.asynciterable",
			"dom.iterable",
			"deno.ns"
		],
		"types": [
			"vite/client"
		]
	},
	"deploy": {
		"app": "tradao",
		"org": "turitoyuenan"
	},
	"exclude": [
		"**/_fresh/*"
	],
	"fmt": {
		"options": {
			"indentWidth": 4,
			"lineWidth": 120,
			"quoteProps": "consistent",
			"semiColons": true,
			"singleQuote": true,
			"useTabs": true
		}
	},
	"imports": {
		"@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.4",
		"@googleapis/walletobjects": "npm:@googleapis/walletobjects@^7.0.1",
		"@preact/signals": "npm:@preact/signals@^2.3.2",
		"@supabase/supabase-js": "npm:@supabase/supabase-js@^2.0.0",
		"@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
		"$components/": "./components/",
		"$islands/": "./islands/",
		"$lib/": "./lib/",
		"$std/": "https://deno.land/std@0.216.0/",
		"fresh": "jsr:@fresh/core@^2.1.2",
		"jsqr": "https://esm.sh/jsqr@1.4.0",
		"preact": "npm:preact@^10.27.2",
		"tailwindcss": "npm:tailwindcss@^4.1.10",
		"vite": "npm:vite@^7.1.3",
		"yup": "https://esm.sh/yup@1.7.0"
	},
	"lint": {
		"rules": {
			"tags": [
				"fresh",
				"recommended"
			]
		}
	},
	"nodeModulesDir": "auto",
	"tasks": {
		"build": "vite build",
		"check": "deno fmt --check . && deno lint . && deno check",
		"dev": "vite",
		"start": "deno serve -A _fresh/server.js",
		"update": "deno run -A -r jsr:@fresh/update ."
	}
}
