{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"assets": {
		"binding": "ASSETS",
		"directory": "./svelte-kit/cloudflare"
	},
	"compatibility_date": "2025-12-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./.cloudflare/worker.js",
	"name": "tradao",
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
